# VAPID pública: la consume el frontend para pushManager.subscribe (NO es secreto)
VITE_VAPID_PUBLIC_KEY=

# VAPID_PRIVATE_KEY: SOLO en Secret Manager (firebase functions:secrets:set VAPID_PRIVATE_KEY).
# NUNCA commitear el valor. La pública del cron va como env var de functions (VAPID_PUBLIC_KEY).